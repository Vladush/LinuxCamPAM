FROM debian:sid

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Dependencies (plus build tools for OpenCV)
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libpam0g-dev \
    libjsoncpp-dev \
    nlohmann-json3-dev \
    libgtest-dev \
    v4l-utils \
    git \
    wget \
    unzip \
    pkg-config \
    python3-dev \
    gfortran \
    libjpeg-dev libpng-dev libtiff-dev \
    libavcodec-dev libavformat-dev libswscale-dev libv4l-dev \
    libxvidcore-dev libx264-dev \
    ca-certificates \
    devscripts \
    debhelper \
    dh-cmake \
    && rm -rf /var/lib/apt/lists/*

# Build OpenCV 4.12.0 Static from Source
WORKDIR /opencv_build
RUN wget -O opencv.zip https://github.com/opencv/opencv/archive/4.12.0.zip && \
    unzip -q opencv.zip && \
    mkdir build && cd build && \
    cmake -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_INSTALL_PREFIX="/app/opencv_static" \
    -D BUILD_SHARED_LIBS=OFF \
    -D OPENCV_GENERATE_PKGCONFIG=ON \
    -D WITH_GTK=OFF \
    -D WITH_QT=OFF \
    -D WITH_V4L=ON \
    -D WITH_FFMPEG=ON \
    -D WITH_GSTREAMER=OFF \
    -D WITH_ADE=OFF \
    -D WITH_EIGEN=OFF \
    -D WITH_OPENEXR=OFF \
    -D BUILD_EXAMPLES=OFF \
    -D BUILD_TESTS=OFF \
    -D BUILD_PERF_TESTS=OFF \
    -D BUILD_JAVA=OFF \
    -D BUILD_PYTHON3=OFF \
    -D BUILD_opencv_python3=OFF \
    -D BUILD_opencv_apps=OFF \
    -D BUILD_opencv_gapi=OFF \
    -D BUILD_opencv_highgui=OFF \
    -D BUILD_opencv_stitching=OFF \
    -D BUILD_opencv_ts=OFF \
    -D BUILD_opencv_python_bindings_generator=OFF \
    -D OPENCV_DNN_OPENCL=ON \
    ../opencv-4.12.0 && \
    make -j$(nproc) && \
    make install && \
    cd / && rm -rf /opencv_build

# Set Working Directory
WORKDIR /app

# Copy Source Code
COPY . /app

# Download models
RUN ./scripts/download_models.sh && \
    mkdir -p /usr/share/linuxcampam/models && \
    cp models/*.onnx /usr/share/linuxcampam/models/

# Explicit Regression Testing
ENV TEST_IN_DOCKER=1
# Build and run tests before packaging to ensure quality
RUN mkdir build_testing && cd build_testing && \
    cmake .. && \
    make -j$(nproc) linuxcampam_tests && \
    ctest --output-on-failure && \
    cd .. && rm -rf build_testing

# Ensure Clean Build
RUN rm -rf build && mkdir build

# Build and Package
RUN dpkg-buildpackage -b -uc -us && \
    mkdir -p /artifacts && \
    cp ../*.deb /artifacts/ && \
    dpkg -i ../*.deb || apt-get install -f -y

# Verification Command
CMD ["/usr/bin/linuxcampam", "help"]
