# ==========================================
# Stage 1: Builder
# ==========================================
FROM i386/debian:bookworm AS builder

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Build Dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libpam0g-dev \
    libjsoncpp-dev \
    nlohmann-json3-dev \
    libgtest-dev \
    v4l-utils \
    git \
    wget \
    unzip \
    pkg-config \
    python3-dev \
    gfortran \
    libjpeg-dev libpng-dev libtiff-dev \
    libv4l-dev \
    libxvidcore-dev libx264-dev \
    libatlas-base-dev \
    libatomic1 \
    ca-certificates \
    devscripts \
    debhelper \
    dh-cmake \
    && rm -rf /var/lib/apt/lists/*

# Build OpenCV 4.12.0 Static from Source
COPY scripts/build_opencv.sh /tmp/build_opencv.sh
RUN chmod +x /tmp/build_opencv.sh && \
    mkdir -p /opencv_build && cd /opencv_build && \
    SKIP_DEPS=1 INSTALL_DIR="/app/opencv_static" /tmp/build_opencv.sh && \
    cd / && rm -rf /opencv_build /tmp/build_opencv.sh

# Set Working Directory
WORKDIR /app

# Copy Source Code
COPY . /app

# Download models to include in the package
RUN ./scripts/download_models.sh \
    # Install models for testing
    && mkdir -p /usr/share/linuxcampam/models \
    && cp /app/models/*.onnx /usr/share/linuxcampam/models/

# Explicit Regression Testing
ENV TEST_IN_DOCKER=1
# Build and run tests before packaging
RUN mkdir build_testing && cd build_testing && \
    cmake .. && \
    make -j$(nproc) linuxcampam_tests && \
    ctest --output-on-failure && \
    cd .. && rm -rf build_testing

# Build and Package
RUN rm -rf build && mkdir build && \
    dpkg-buildpackage -b -uc -us -d && \
    mkdir -p /artifacts && \
    cp ../*.deb /artifacts/

# ==========================================
# Stage 2: Runtime
# ==========================================
FROM i386/debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# Install Runtime Dependencies ONLY
# Note: OpenCV is static, but we need PAM, V4L, and common libs
RUN apt-get update && apt-get install -y \
    libpam0g \
    libpam-runtime \
    v4l-utils \
    systemd \
    libgfortran5 \
    libatlas3-base \
    libgomp1 \
    libatomic1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the .deb package and artifacts directory from the builder stage
COPY --from=builder /artifacts /artifacts
COPY --from=builder /artifacts/*.deb /tmp/linuxcampam.deb

# Install the package
# Install the package (re-updating apt because lists were cleared)
RUN apt-get update && \
    apt-get install -y /tmp/linuxcampam.deb && \
    rm -rf /var/lib/apt/lists/* && \
    rm /tmp/linuxcampam.deb

# Verification
CMD ["/usr/bin/linuxcampam", "help"]

