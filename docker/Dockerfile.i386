FROM i386/debian:bookworm

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libopencv-dev \
    libpam0g-dev \
    libjsoncpp-dev \
    libjsoncpp-dev \
    nlohmann-json3-dev \
    libgtest-dev \
    v4l-utils \
    git \
    wget \
    ca-certificates \
    devscripts \
    debhelper \
    dh-cmake \
    && rm -rf /var/lib/apt/lists/*

# Set Working Directory
WORKDIR /app

# Copy Source Code
COPY . /app

# Download models (ensures they're included even if buildx context differs)
RUN ./scripts/download_models.sh

# Explicit Regression Testing
ENV TEST_IN_DOCKER=1
# Build and run tests before packaging to ensure quality
RUN mkdir build_testing && cd build_testing && \
    cmake .. && \
    make -j$(nproc) linuxcampam_tests && \
    ./linuxcampam_tests && \
    cd .. && rm -rf build_testing

# Ensure Clean Build
RUN rm -rf build && mkdir build

# Build and Package
RUN dpkg-buildpackage -b -uc -us && \
    mkdir -p /artifacts && \
    cp ../*.deb /artifacts/ && \
    dpkg -i ../*.deb || apt-get install -f -y

# Verification
CMD ["/usr/bin/linuxcampam", "help"]
