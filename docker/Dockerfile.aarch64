FROM ubuntu:22.04

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libopencv-dev \
    libpam0g-dev \
    libjsoncpp-dev \
    libjsoncpp-dev \
    nlohmann-json3-dev \
    libgtest-dev \
    v4l-utils \
    git \
    wget \
    ca-certificates \
    devscripts \
    debhelper \
    dh-cmake \
    && rm -rf /var/lib/apt/lists/*

# Set Working Directory
WORKDIR /app

# Copy Source Code
COPY . /app

# Ensure Clean Build
RUN rm -rf build && mkdir build

# Download models
RUN ./scripts/download_models.sh && \
    mkdir -p /usr/share/linuxcampam/models && \
    cp models/*.onnx /usr/share/linuxcampam/models/

# Explicit Regression Testing
ENV TEST_IN_DOCKER=1
# Build and run tests before packaging to ensure quality
RUN mkdir build_testing && cd build_testing && \
    cmake .. && \
    make -j$(nproc) linuxcampam_tests && \
    ctest --output-on-failure && \
    cd .. && rm -rf build_testing

# Build and Package
# dpkg-buildpackage with cmake buildsystem will handle the build process
# We skip signing (-uc -us)
RUN dpkg-buildpackage -b -uc -us && \
    dpkg -i ../*.deb || apt-get install -f -y

# Verification Command (to run manually)
CMD ["/usr/bin/linuxcampam", "help"]
