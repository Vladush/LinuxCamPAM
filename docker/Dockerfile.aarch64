FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    build-essential cmake libopencv-dev libpam0g-dev \
    libjsoncpp-dev nlohmann-json3-dev v4l-utils \
    libgtest-dev devscripts debhelper dh-cmake pandoc git

WORKDIR /src
COPY . .
# Clean up any existing artifacts from host
RUN rm -rf build CMakeFiles CMakeCache.txt

# Build using dpkg-buildpackage to match CI
RUN dpkg-buildpackage -b -uc -us

# Verify man pages are in the generated deb
RUN dpkg -c ../linuxcampam_*.deb | grep share/man
RUN apt-get update && apt-get install -y ../linuxcampam_*.deb
